<Window x:Class="CorpoHumanoInterativo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VideoTrigger"
        Height="760"
        Width="1100"
        MinHeight="650"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#111827">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CABEÇALHO -->
        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Center"
            Margin="0,20,0,10">

            <TextBlock
                Text="VideoTrigger"
                Foreground="White"
                FontSize="34"
                FontWeight="Bold"
                HorizontalAlignment="Center"/>

            <TextBlock
                Text="Player de vídeos acionado por Arduino"
                Foreground="#9CA3AF"
                FontSize="16"
                HorizontalAlignment="Center"
                Margin="0,5,0,0"/>

        </StackPanel>

        <!-- PLAYER -->
        <Border
            Grid.Row="1"
            Margin="30,10,30,20"
            Background="Black"
            CornerRadius="10">

            <MediaElement
                x:Name="VideoPlayer"
                LoadedBehavior="Manual"
                UnloadedBehavior="Stop"
                Stretch="Uniform"/>

        </Border>

        <!-- CONTROLES -->
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            Margin="20">

            <!-- CONEXÃO COM ARDUINO -->
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,0,0,15">

                <TextBlock
                    Text="Arduino:"
                    Foreground="White"
                    FontSize="16"
                    VerticalAlignment="Center"
                    Margin="5"/>

                <ComboBox
                    x:Name="PortasComboBox"
                    Width="120"
                    Height="35"
                    Margin="5"/>

                <Button
                    Content="Atualizar"
                    Width="100"
                    Height="35"
                    Margin="5"
                    Click="BotaoAtualizarPortas_Click"/>

                <Button
                    Content="Conectar"
                    Width="100"
                    Height="35"
                    Margin="5"
                    Click="BotaoConectarArduino_Click"/>

                <TextBlock
                    x:Name="StatusArduino"
                    Text="Desconectado"
                    Foreground="#D1D5DB"
                    FontSize="14"
                    VerticalAlignment="Center"
                    Margin="10,0"/>

            </StackPanel>

            <!-- VÍDEOS CADASTRADOS -->
            <TextBlock
                Text="Vídeos cadastrados"
                Foreground="White"
                FontSize="16"
                FontWeight="SemiBold"
                HorizontalAlignment="Center"
                Margin="0,0,0,8"/>

            <ScrollViewer
                MaxHeight="120"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

                <WrapPanel
                    x:Name="PainelVideos"
                    HorizontalAlignment="Center"/>

            </ScrollViewer>

            <!-- GERENCIAMENTO -->
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,10,0,5">

                <Button
                    Content="+ Adicionar vídeo"
                    Width="180"
                    Height="40"
                    Margin="10,5"
                    FontSize="14"
                    Click="BotaoAdicionarVideo_Click"/>

                <Button
                    Content="Gerenciar vídeos"
                    Width="180"
                    Height="40"
                    Margin="10,5"
                    FontSize="14"
                    Click="BotaoGerenciarVideos_Click"/>

            </StackPanel>

            <!-- PLAY / PAUSE -->
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center">

                <Button
                    x:Name="BotaoPlayPause"
                    Content="Pausar"
                    Width="160"
                    Height="48"
                    Margin="10"
                    FontSize="16"
                    IsEnabled="False"
                    Click="BotaoPlayPause_Click"/>

            </StackPanel>

        </StackPanel>

    </Grid>

</Window>