<Window x:Class="CorpoHumanoInterativo.GerenciarVideosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerenciar vídeos"
        Height="500"
        Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#111827">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Text="Gerenciar vídeos"
            Foreground="White"
            FontSize="26"
            FontWeight="Bold"
            Margin="0,0,0,20"/>

        <DataGrid
            x:Name="VideosDataGrid"
            Grid.Row="1"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            SelectionMode="Single"
            CanUserAddRows="False"
            HeadersVisibility="Column">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Header="Nome"
                    Binding="{Binding Nome}"
                    Width="*"/>

                <DataGridTextColumn
                    Header="Pino"
                    Binding="{Binding Pino}"
                    Width="100"/>

                <DataGridTextColumn
                    Header="Vídeo"
                    Binding="{Binding Video}"
                    Width="250"/>

            </DataGrid.Columns>

        </DataGrid>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,20,0,0">

            <Button
                Content="Fechar"
                Width="110"
                Height="40"
                Margin="5"
                Click="BotaoFechar_Click"/>

            <Button
                Content="Editar selecionado"
                Width="160"
                Height="40"
                Margin="5"
                Click="BotaoEditar_Click"/>

            <Button
                Content="Excluir selecionado"
                Width="160"
                Height="40"
                Margin="5"
                Click="BotaoExcluir_Click"/>

        </StackPanel>

    </Grid>

</Window>